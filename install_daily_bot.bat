@echo off
setlocal
cd /d "%~dp0"

if not exist ".git" (
  echo ERROR: Put this file inside your TechBangla_AI_Bot project folder.
  pause
  exit /b 1
)

if not exist ".github" mkdir ".github"
if not exist ".github\workflows" mkdir ".github\workflows"

powershell -NoProfile -Command "$b=[Convert]::FromBase64String(''); [IO.File]::WriteAllBytes('.github\workflows\daily-post.yml',$b)"
if errorlevel 1 (
  echo ERROR: Could not create workflow file.
  pause
  exit /b 1
)

echo.
echo Created .github\workflows\daily-post.yml
echo.

git add .github/workflows/daily-post.yml
git commit -m "Add twice-daily GitHub Actions bot"
if errorlevel 1 (
  echo.
  echo NOTE: Git may report nothing to commit if the workflow is already installed.
)

git push
if errorlevel 1 (
  echo.
  echo ERROR: git push failed. Read the message above.
  pause
  exit /b 1
)

echo.
echo SUCCESS: Workflow pushed to GitHub.
echo NEXT: Add the 3 repository secrets in GitHub Settings ^> Secrets and variables ^> Actions.
echo   GEMINI_API_KEY
echo   GOOGLE_CREDENTIALS_JSON
echo   GOOGLE_TOKEN_JSON
echo.
pause
